# Campus Pulse AI web app: environment variables.
# Copy to apps/web/.env.local for local development. NEVER commit .env.local.
#
# !! Everything here is NEXT_PUBLIC_*: it is baked into the JavaScript sent to every browser.
# !! NEVER put the Supabase service role key, the JWT secret or any database URL in this file
# !! or in the Vercel project. Those belong only to the API (Render) and GitHub secrets.
#
# In production set these in the Vercel dashboard > Project > Settings > Environment Variables.

# Base URL of the FastAPI service. Local: http://localhost:8000.
# Production: your Render service URL (Render dashboard > service > top of page), https://<name>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for chat (used from M3). Local: ws://localhost:8000. Production: wss://<name>.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Supabase dashboard > Project Settings > API (Data API): Project URL. Use the DEV project locally.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard > Project Settings > API Keys: the anon / publishable (public) key.
# Safe in the browser only because every table has RLS enabled with no policies (D16).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
