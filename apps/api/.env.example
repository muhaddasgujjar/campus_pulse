# Campus Pulse AI API: environment variables.
# Copy to apps/api/.env for local development. NEVER commit .env (only this example is in git).
#
# !! The Supabase service role key, the JWT secret and BOTH database URLs are server secrets.
# !! They must never appear in the web app (apps/web), in NEXT_PUBLIC_* variables, or in git.
# !! In production they live only in the Render dashboard and in GitHub repository secrets.
#
# Empty values mean "not configured": the API still starts and /readyz reports not_configured.

# --- app -------------------------------------------------------------------------------
# local | test | ci | dev | prod. Set in each environment by you (Render dashboard for prod).
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated web origins allowed to call the API. Local: the Next.js dev server.
# Production: your Vercel URL (Vercel dashboard > Project > Domains), e.g. https://<project>.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- institution (ADP-2) ---------------------------------------------------------------
# Slug of the institution row (seed/<slug>/). LGU is the first institution.
INSTITUTION_SLUG=lgu
# Optional override of the disclaimer shown in the chat footer (PRD CHAT-8). Leave empty for the default.
INSTITUTION_DISCLAIMER=

# --- database: Supabase Postgres (use the DEV project locally, never prod) -------------
# Supabase dashboard > your project > Connect (or Project Settings > Database) > Connection string.
# Transaction pooler URL (port 6543), used by the running app. SECRET.
DATABASE_URL=
# Session pooler URL (port 5432 on the pooler host), used only by Alembic migrations. SECRET.
DATABASE_URL_MIGRATIONS=

# --- supabase auth / admin API ---------------------------------------------------------
# Supabase dashboard > Project Settings > API (Data API): Project URL.
SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys: service_role (secret) key. SECRET, server only.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard > Project Settings > JWT Keys: legacy JWT secret (used for token verification in M5). SECRET.
SUPABASE_JWT_SECRET=

# --- redis: Upstash (free database) ----------------------------------------------------
# Upstash console > your Redis database > Connect > the rediss:// URL (TLS). SECRET.
# Locally you can use the optional compose redis instead: redis://redis:6379/0
REDIS_URL=

# --- LLM: Google Gemini API, free tier (D15) -------------------------------------------
# Google AI Studio (aistudio.google.com) > Get API key. SECRET. Leave empty to use templates only.
GEMINI_API_KEY=
# Provider fallback chain, first to last.
LLM_PROVIDERS=gemini,template
# Model IDs from AI Studio's current free list. Record your choice in docs/Memory.md (no defaults in code).
# Fast model: planning (LLM call 1). Main model: answers (LLM call 2).
LLM_MODEL_FAST=
LLM_MODEL_MAIN=
# Embeddings (D17). Changing model or dimension needs a migration and a full re-embed.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# LLM budget per user turn (COST-2). Maximum allowed value is 2.
MAX_LLM_CALLS_PER_TURN=2

# --- ops -------------------------------------------------------------------------------
# Shared secret for POST /internal/jobs/daily (called by GitHub Actions). Generate a long
# random string yourself, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Put the same value in Render and in the GitHub secret INTERNAL_JOBS_SECRET. SECRET.
INTERNAL_JOBS_SECRET=
# Days to keep chat messages before the daily purge (COST-8).
CHAT_RETENTION_DAYS=60
