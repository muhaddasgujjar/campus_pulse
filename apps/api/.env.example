# Campus Pulse AI API: environment variables.
# Copy to apps/api/.env for local development. NEVER commit .env (only this example is in git).
#
# !! The Supabase service role key, the JWT secret and BOTH database URLs are server secrets.
# !! They must never appear in the web app (apps/web), in NEXT_PUBLIC_* variables, or in git.
# !! In production they live only in the Render dashboard and in GitHub repository secrets.
#
# Empty values mean "not configured": the API still starts and /readyz reports not_configured.

# --- app -------------------------------------------------------------------------------
# local | test | ci | dev | prod. Set in each environment by you (Render dashboard for prod).
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated web origins allowed to call the API. Local: the Next.js dev server.
# Production: your Vercel URL (Vercel dashboard > Project > Domains), e.g. https://<project>.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- institution (ADP-2) ---------------------------------------------------------------
# Slug of the institution row (seed/<slug>/). LGU is the first institution.
INSTITUTION_SLUG=lgu
# Optional override of the disclaimer shown in the chat footer (PRD CHAT-8). Leave empty for the default.
INSTITUTION_DISCLAIMER=
# The institution's offset from UTC, for "today" in date answers (rule 3). Pakistan: 5.
INSTITUTION_UTC_OFFSET_HOURS=5

# --- database: Supabase Postgres (use the DEV project locally, never prod) -------------
# Supabase dashboard > your project > Connect (or Project Settings > Database) > Connection string.
# Transaction pooler URL (port 6543), used by the running app. SECRET.
DATABASE_URL=
# Session pooler URL (port 5432 on the pooler host), used only by Alembic migrations. SECRET.
DATABASE_URL_MIGRATIONS=

# --- supabase auth / admin API ---------------------------------------------------------
# Supabase dashboard > Project Settings > API (Data API): Project URL.
SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys: service_role (secret) key. SECRET, server only.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard > Project Settings > JWT Keys: legacy JWT secret (used for token verification in M5). SECRET.
SUPABASE_JWT_SECRET=

# --- redis: Upstash (free database) ----------------------------------------------------
# Upstash console > your Redis database > Connect > the rediss:// URL (TLS). SECRET.
# Locally you can use the optional compose redis instead: redis://redis:6379/0
REDIS_URL=

# --- LLM: Google Gemini API, free tier (D15) -------------------------------------------
# Google AI Studio (aistudio.google.com) > Get API key. SECRET. Leave empty to use templates only.
GEMINI_API_KEY=
# Provider fallback chain, first to last: groq, gemini, fake (tests), template (no more LLMs).
LLM_PROVIDERS=groq,gemini,template
# Gemini model IDs from AI Studio's current free list. Record your choice in docs/Memory.md (no defaults in code).
# Fast model: planning (LLM call 1). Main model: answers (LLM call 2).
LLM_MODEL_FAST=
LLM_MODEL_MAIN=

# --- LLM: Groq free tier (console.groq.com > API Keys, no card). LLM only: no embeddings ---
GROQ_API_KEY=
# Free-tier models (2026-10-05): openai/gpt-oss-20b and openai/gpt-oss-120b (30 RPM, 1K RPD, 8K TPM each).
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_MAIN=openai/gpt-oss-120b
# gpt-oss reasoning effort: low keeps tokens inside the 8K tokens-per-minute free limit.
GROQ_REASONING_EFFORT=low
# Embeddings (D17). Changing model or dimension needs a migration and a full re-embed.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# LLM budget per user turn (COST-2). Maximum allowed value is 2.
MAX_LLM_CALLS_PER_TURN=2
# Texts per embedding request when indexing.
EMBEDDING_BATCH_SIZE=16
# Seconds before an LLM request is abandoned (the next provider or a template answers instead).
LLM_TIMEOUT_SECONDS=25

# --- quota guard per provider (COST-4). Copy the limits from each dashboard.
# Empty = no local limit (a 429 is still handled: next provider, then templates or the busy message).
GEMINI_RPM_LIMIT=
GEMINI_RPD_LIMIT=
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
# Near the per-minute limit, wait up to this many seconds (with backoff) before giving up.
QUOTA_MAX_WAIT_SECONDS=20
# Response cache lifetime (COST-3). Redis when REDIS_URL is set, else in process. 0 = off.
RESPONSE_CACHE_TTL_SECONDS=3600

# --- chat (M3) ------------------------------------------------------------------------------
# Anonymous rate limit per IP (CHAT-7): this many messages per window.
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=600
# Session memory (CHAT-5): last N question/answer turns, kept this long.
SESSION_MEMORY_TURNS=6
SESSION_MEMORY_TTL_SECONDS=86400
# Longest accepted chat message, in characters (SEC-2).
CHAT_MAX_MESSAGE_CHARS=1000

# --- voice (M4) -------------------------------------------------------------------------
# Voice runs in the browser (Web Speech API). Browsers without speech recognition upload the
# recording to POST /api/voice/transcribe, which asks Gemini (needs GEMINI_API_KEY). Audio is
# processed in memory and never stored. Gemini model ID with audio input, from AI Studio's free
# list (record it in docs/Memory.md). Empty = the fallback is off and those browsers type instead.
STT_MODEL=
# Largest accepted recording, in MB (the browser stops recording at 60 seconds).
VOICE_MAX_MB=10

# --- retrieval and grading (tune on the golden set with `make eval`) -------------------
RETRIEVAL_TOP_K=5
# Cosine similarity (0-1) of the best chunk that counts as a confident match.
RETRIEVAL_MIN_SIMILARITY=0.62
# Or: share of the question's content words found in the best chunk.
RETRIEVAL_MIN_KEYWORD_COVERAGE=0.6

# --- ingestion -------------------------------------------------------------------------
# Largest PDF accepted for upload, in MB (text PDFs only, no OCR).
PDF_MAX_MB=10

# --- ops -------------------------------------------------------------------------------
# Shared secret for POST /internal/jobs/daily (called by GitHub Actions). Generate a long
# random string yourself, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Put the same value in Render and in the GitHub secret INTERNAL_JOBS_SECRET. SECRET.
INTERNAL_JOBS_SECRET=
# Days to keep chat messages before the daily purge (COST-8).
CHAT_RETENTION_DAYS=60
